# Copy to .env.local and fill in what you need. Every value is optional.

# AI Code Convert. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Run Code for Java, C, C++, Go, Rust and other server-side languages.
# Point at your own Piston instance (https://github.com/engineer-man/piston), e.g. http://localhost:2000
# JavaScript, TypeScript and Python run in the browser without it.
PISTON_URL=

# Port for npm run dev / npm start (default 3000)
# PORT=3000
